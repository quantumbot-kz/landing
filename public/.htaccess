# Security headers for hosts that still honor Apache/.htaccess behind the edge.
# Pure-nginx Beget panels need the same directives in site Nginx settings.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Hashed Nuxt assets and media: long cache. HTML stays validators/ETag only
# so a deploy is visible without waiting a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2|webp|png|jpe?g|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
